# =============================================================================
# Variables de entorno — Pasarela de pagos (Chile + Colombia)
# Copia este archivo a ".env" y completa tus credenciales.
# NUNCA subas el archivo .env real al repositorio.
# =============================================================================

# ------------------------------- Servidor ------------------------------------
PORT=3000
# URL publica donde estara la web (en produccion: https://tudominio.com)
# IMPORTANTE: para que la app se pueda INSTALAR (PWA) debe ser HTTPS.
PUBLIC_URL=https://tudominio.com
COMMERCE_NAME=Mi Negocio de Servicios
ORDER_TIMEOUT=3600

# =============================================================================
# CHILE — Flow (https://www.flow.cl)
# Regístrate como comercio (requiere RUT + inicio de actividades en el SII).
# Sandbox: https://sandbox.flow.cl  |  Produccion: https://www.flow.cl
# =============================================================================
FLOW_API_KEY=
FLOW_SECRET_KEY=
# 'sandbox' o 'production'
FLOW_ENV=sandbox
# 9 = Cupon de pago (efectivo: Servipag / Servipag Express / Sencillito)
FLOW_PM_EFECTIVO=9
# 1 = Tarjeta de credito/debito
FLOW_PM_TARJETA=1

# =============================================================================
# COLOMBIA — Wompi (https://wompi.co, grupo Bancolombia)
# Regístrate como comercio (KYC con cedula colombiana).
# Sandbox: pub_test_/prv_test_  |  Produccion: pub_prod_/prv_prod_
# =============================================================================
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# 'sandbox' o 'production'
WOMPI_ENV=sandbox

# =============================================================================
# LIQUIDACION A TU CUENTA NEQUI (Wompi "Pagos a Terceros")
# Con esto el dinero cobrado en Colombia se dispersa a tu Nequi.
# =============================================================================
# true = dispersar automaticamente al confirmarse el pago
SETTLE_TO_NEQUI=true

# Credenciales de "Pagos a Terceros" (Wompi Dispersiones)
WOMPI_PAYOUTS_API_KEY=
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=
WOMPI_PAYOUTS_ACCOUNT_ID=
WOMPI_PAYOUTS_BASE_URL=https://api.payouts.wompi.co/v1

# Datos de TU cuenta Nequi (destino del dinero)
NEQUI_PHONE=3001234567
NEQUI_LEGAL_ID=1234567890
NEQUI_LEGAL_ID_TYPE=CC
NEQUI_NAME=Tu Nombre
NEQUI_EMAIL=tucorreo@ejemplo.com
